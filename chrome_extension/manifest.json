{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "downloads",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:17863/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "options.html",
    "default_title": "ND Launcher",
    "default_icon": {
      "16": "icons/nd-16.png",
      "32": "icons/nd-32.png",
      "48": "icons/nd-48.png",
      "128": "icons/nd-store-128.png"
    }
  },
  "icons": {
    "16": "icons/nd-16.png",
    "32": "icons/nd-32.png",
    "48": "icons/nd-48.png",
    "128": "icons/nd-store-128.png"
  }
}
